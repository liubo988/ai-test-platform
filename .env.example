# Primary LLM runtime configuration
# Current implementation only enables openai, but gemini / claude are reserved for future provider adapters.
LLM_PROVIDER=openai
LLM_MODEL=api-proxy-codex/gpt-5.3-codex
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_API_STYLE=responses
LLM_VISION_ENABLED=true
LLM_SELF_HEAL_RETRIES=2
LLM_MAX_PLAN_STEPS=8
INTENT_E2E_PROJECT_KNOWLEDGE_PATH=
INTENT_E2E_PROJECT_KNOWLEDGE_DRAFT_PATH=
INTENT_E2E_PROJECT_KNOWLEDGE_BACKUP_DIR=
INTENT_E2E_REPAIR_MEMORY_PATH=

# Backward-compatible OpenAI/Azure aliases
OPENAI_API_KEY=
OPENAI_MODEL=api-proxy-codex/gpt-5.3-codex
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_RETRY_DELAY_MS=350
OPENAI_RESPONSES_MAX_ATTEMPTS=2

# Database Configuration (MySQL)
DB_HOST=your-db-host.mysql.rds.aliyuncs.com
DB_USER=root
DB_PASSWORD=
DB_NAME=course_test
DB_PORT=3306
DB_POOL_SIZE=10

# Secret for encrypting saved passwords (must set in production)
APP_CRYPTO_KEY=change_me_to_a_long_random_secret
